  ],
  "readinessRequirements": [
    "GitHub App JWT signs successfully with the configured PKCS#8 private key.",
    "GET /app returns the configured App ID.",
    "An installation token can be issued with Actions: write.",
    "The installation can access all required repositories.",
    "The installation token can read the expected Actions workflow in every required repository.",
    "The readiness token is revoked after verification.",
    "A fresh readiness receipt with state ready exists before the dispatcher may issue any workflow_dispatch call."
  ],
  "invariants": [
    "No webhook subscription is required.",
    "No user OAuth authorization is required.",
    "The App is private to its owner.",
    "Repository selection must remain selected, not all repositories.",
    "The App never bypasses repo-bound GitHub Actions OIDC.",
    "The App never records trusted release-head or rollback-source evidence.",
    "Private key, App JWT and installation token values are never written to Postgres."
