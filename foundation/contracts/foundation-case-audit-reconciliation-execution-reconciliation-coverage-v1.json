  "reader": "foundation.get_case_audit_reconcile_exec_reconciliation_coverage_v1",
  "sourceLayer86Ledger": "foundation.case_audit_verify_reconcile_exec_events",
  "sourceLayer87Ledger": "foundation.case_audit_verify_reconcile_exec_reconciliations",
  "linkedLayer82Ledger": "foundation.case_audit_verify_exec_reconciliations",
  "overallStates": [
    "idle",
    "normal",
    "pending",
    "gap",
    "invalid"
  ],
  "itemStates": [
    "pending",
    "overdue",
    "invalid-reconciliation",
    "reconciled",
    "missing-layer82-receipt",
    "invalid-layer82-receipt",
    "execution-receipt-mismatch",
    "policy-drift",
    "incident-drift",
    "coverage-drift"
  ],
  "metrics": {
    "coverage": "layer87ReconciliationCoveragePercent",
    "health": "healthyLayer87ReconciliationPercent"
  },
  "invariants": {
    "onlySuccessfulLayer86ExecutionsRequireLayer87Reconciliation": true,
    "receiptCoverageSeparatedFromReconciliationHealth": true,
