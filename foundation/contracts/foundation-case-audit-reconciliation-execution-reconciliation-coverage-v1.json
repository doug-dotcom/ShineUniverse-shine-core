    "layer87ProofEnvelopeRevalidated": true,
    "layer86SnapshotBoundToSourceExecution": true,
    "linkedLayer82SnapshotRevalidated": true,
    "readerPerformsNoLayer87Reconciliation": true,
    "noLayer86Rerun": true,
    "noLayer82Rerun": true,
    "noLayer81Rerun": true,
    "noVerificationRerun": true,
    "noEvidenceMutation": true,
    "noReconciliationReceiptRewrite": true,
    "noVerificationProofRewrite": true,
    "noReleaseTruthMutation": true,
    "noIncidentHistoryMutation": true,
    "gatewayReadInheritedViaFoundationRuntime": true,
    "gatewayReceivesNoDirectGrant": true,
    "ownerDenied": true,
    "defenceDenied": true,
    "browserRolesDenied": true
  }
