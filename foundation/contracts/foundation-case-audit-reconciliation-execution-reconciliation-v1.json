{
  "contract": "shine-foundation/case-audit-reconciliation-execution-reconciliation-v1",
  "version": "1.0.0",
  "layer": 87,
  "purpose": "Independently reconcile each successful Layer-86 execution claim against the durable Layer-82 reconciliation receipt, Layer-86 policy fingerprint, bound Layer-84 incident evidence and stored coverage snapshots without rerunning or mutating any upstream control.",
  "evaluator": "foundation.evaluate_case_audit_verify_reconcile_exec_outcome_v1",
  "runner": "foundation.run_case_audit_verify_reconcile_exec_reconciliation_v1",
  "summary": "foundation.get_case_audit_verify_reconcile_exec_reconciliation_summary_v1",
  "ledger": "foundation.case_audit_verify_reconcile_exec_reconciliations",
  "sourceLayer86Ledger": "foundation.case_audit_verify_reconcile_exec_events",
  "sourceLayer82Ledger": "foundation.case_audit_verify_exec_reconciliations",
  "sourceLayer81Ledger": "foundation.case_audit_verify_exec_events",
  "sourceLayer84IncidentLedger": "foundation.case_audit_verify_reconcile_incident_events",
  "policyFingerprint": "foundation.case_audit_verify_reconcile_exec_policy_fp_v1",
  "states": [
    "reconciled",
    "missing-layer82-receipt",
    "invalid-layer82-receipt",
    "execution-receipt-mismatch",
    "policy-drift",
    "incident-drift",
    "coverage-drift"
  ],
  "invariants": {
    "onlySuccessfulLayer86ExecutionsAreApplicable": true,
    "layer86PolicyFingerprintRecomputed": true,
    "layer85DecisionEnvelopeRevalidated": true,
    "layer84IncidentBindingRevalidated": true,
    "layer81TargetBindingRevalidated": true,
    "layer82ProofHashRecomputed": true,
    "layer82ProofEnvelopeRevalidated": true,
    "layer86ActionResultMustMatchDurableLayer82Receipt": true,
    "beforeAndAfterCoverageSnapshotsValidated": true,
    "negativeLayer82OutcomeCanStillYieldTruthfulLayer86Reconciliation": true,
    "reconciliationHistoryAppendOnly": true,
    "serviceRoleCannotDirectInsertReconciliationLedger": true,
    "noLayer82Rerun": true,
    "noLayer81Rerun": true,
    "noVerificationRerun": true,
    "noEvidenceMutation": true,
    "noReconciliationReceiptRewrite": true,
    "noVerificationProofRewrite": true,
    "noReleaseTruthMutation": true,
    "noIncidentHistoryMutation": true,
    "noAuthorityExpansion": true,
    "gatewayReadInheritedViaFoundationRuntime": true,
    "gatewayReceivesNoDirectGrant": true,
    "ownerDenied": true,
    "defenceDenied": true,
    "browserRolesDenied": true,
    "layer82ReconciliationForeignKeyIndexed": true
  },
  "supportingIndexes": [
    "foundation.case_audit_verify_reconcile_exec_reconcile_layer82_idx"
  ]
}
