{
  "contract": "shine-foundation/case-audit-layer92-reconciliation-coverage-incident-lifecycle-v1",
  "version": "1.0.0",
  "layer": 94,
  "purpose": "Escalate persistent Layer-93 GAP or INVALID coverage states into append-only operational incident evidence without automatically creating Layer-92 reconciliation, rerunning Layer 91/87/86/82/81, repairing evidence, rewriting receipts, or mutating authoritative truth.",
  "source": "foundation.get_case_audit_layer92_reconciliation_coverage_v1",
  "fingerprint": "foundation.case_audit_layer92_coverage_incident_fingerprint_v1",
  "ledger": "foundation.case_audit_layer92_coverage_incident_events",
  "currentStateView": "foundation.current_case_audit_layer92_coverage_incident_state",
  "activeIncidentsView": "foundation.current_case_audit_layer92_coverage_incidents",
  "watchesView": "foundation.current_case_audit_layer92_coverage_watches",
  "sentinel": "foundation.run_case_audit_layer92_coverage_incident_sentinel_v1",
  "summary": "foundation.get_case_audit_layer92_coverage_incident_summary_v1",
  "sourceStates": ["idle","normal","pending","gap","invalid"],
  "incidentStates": ["detected","opened","changed","recovered"],
  "incidentSourceStates": ["gap","invalid"],
  "nonIncidentSourceStates": ["idle","normal","pending"],
  "persistenceThresholdSeconds": 300,
  "reconciliationGraceSeconds": 300,
  "severityMapping": {
    "gap": "critical",
    "invalid": "critical",
    "idle": "non-incident",
    "normal": "non-incident",
    "pending": "non-incident"
  },
  "hostedSentinel": {
    "engine": "pg_cron",
    "jobName": "shine-foundation-case-audit-layer92-coverage-incident-5m",
    "cadence": "1,6,11,16,21,26,31,36,41,46,51,56 * * * *"
  },
  "readerRoles": ["foundation_runtime","service_role"],
  "invariants": {
    "pendingWithinGraceNeverCreatesIncident": true,
    "firstGapOrInvalidSampleCreatesWatch": true,
    "persistenceRequiredBeforeOpen": true,
    "unchangedOpenEvidenceDoesNotAppendNoise": true,
    "materialEvidenceChangeAppendsChangedEvent": true,
    "nonIncidentCoverageRecoversWatchOrIncident": true,
    "fingerprintExcludesEvaluationTimeAndExecutionAgeNoise": true,
    "fingerprintBindsLayer93CoverageAndHealthTruth": true,
    "directIncidentInsertDeniedToServiceRole": true,
    "transitionHelperNotCallableByServiceRole": true,
    "sentinelCallableOnlyByServiceRole": true,
    "gatewayReadsSummaryOnlyViaFoundationRuntimeInheritance": true,
    "gatewayReceivesNoDirectSummaryGrant": true,
    "ownerDenied": true,
    "defenceDenied": true,
    "browserRolesDenied": true,
    "automaticLayer92Reconciliation": false,
    "automaticRepair": false,
    "layer91RerunPerformed": false,
    "layer87RerunPerformed": false,
    "layer86RerunPerformed": false,
    "layer82RerunPerformed": false,
    "layer81RerunPerformed": false,
    "verificationRerunPerformed": false,
    "mutatesAuthoritativeTruth": false,
    "mutatesIncidentHistory": false
  }
}
