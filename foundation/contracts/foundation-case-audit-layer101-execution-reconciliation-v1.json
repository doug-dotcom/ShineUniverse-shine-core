{
  "contract": "shine-foundation/case-audit-layer101-execution-reconciliation-v1",
  "version": "1.0.0",
  "layer": 102,
  "purpose": "Independently reconcile one successful Layer-101 bounded Layer-97 reconciliation execution against the durable Layer-97 receipt, recomputing Layer-97 proof integrity and Layer-101 execution-claim fidelity without rerunning or rewriting upstream controls.",
  "evaluator": "foundation.evaluate_case_audit_layer101_execution_outcome_v1",
  "reconciler": "foundation.run_case_audit_layer101_execution_reconciliation_v1",
  "summary": "foundation.get_case_audit_layer101_execution_reconciliation_summary_v1",
  "ledger": "foundation.case_audit_layer101_exec_reconciliations",
  "sourceExecutorLedger": "foundation.case_audit_layer97_reconcile_exec_events",
  "sourceLayer97Ledger": "foundation.case_audit_layer96_exec_reconciliations",
  "sourceLayer96Ledger": "foundation.case_audit_layer92_reconcile_exec_events",
  "sourceLayer99IncidentLedger": "foundation.case_audit_layer97_coverage_incident_events",
  "sourcePolicyFingerprint": "foundation.case_audit_layer97_reconcile_exec_policy_fp_v1",
  "states": [
    "reconciled",
    "missing-layer97-receipt",
    "invalid-layer97-receipt",
    "execution-receipt-mismatch",
    "policy-drift",
    "incident-drift",
    "coverage-drift"
  ],
  "invariants": {
    "oneReceiptPerLayer101Execution": true,
    "onlySuccessfulLayer101ExecutionsCanReconcile": true,
    "layer101PolicyFingerprintRecomputed": true,
    "layer99IncidentBindingRevalidated": true,
    "layer97ProofHashRecomputed": true,
    "layer97ProofStructureRevalidated": true,
    "layer101ActionResultMustMatchLayer97Receipt": true,
    "beforeAndAfterLayer98CoverageRevalidated": true,
    "integrityFailureDominatesExecutionMismatch": true,
    "missingLayer97TruthIsRecordedNotInvented": true,
    "semanticReplayReturnsExistingReceipt": true,
    "reconciliationLedgerAppendOnly": true,
    "serviceRoleCanReconcileButCannotDirectInsert": true,
    "directLayer97BypassRemainsRevoked": true,
    "runtimeCanReadButCannotReconcile": true,
    "gatewayReadOnlyViaFoundationRuntimeInheritance": true,
    "ownerDenied": true,
    "defenceDenied": true,
    "browserRolesDenied": true,
    "noLayer97Rerun": true,
    "noLayer96Rerun": true,
    "noLayer92Rerun": true,
    "noLayer91Rerun": true,
    "noLayer87Rerun": true,
    "noLayer86Rerun": true,
    "noLayer82Rerun": true,
    "noLayer81Rerun": true,
    "noVerificationRerun": true,
    "noEvidenceMutation": true,
    "noLayer97ReceiptRewrite": true,
    "noLayer96ReceiptRewrite": true,
    "noLayer92ReceiptRewrite": true,
    "noReleaseTruthMutation": true,
    "noIncidentHistoryMutation": true,
    "noApprovalGranted": true,
    "noExecutionAuthorityGranted": true
  }
}
