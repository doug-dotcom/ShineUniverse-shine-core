{
  "contract": "shine-foundation/promoted-release-owner-acknowledgement-v1",
  "version": "1.0.0",
  "layer": 68,
  "purpose": "Require the isolated Shine Core control-plane owner to explicitly accept, reject or request clarification for a current Layer-67 promoted-release handoff without granting approval or execution authority.",
  "ownerRole": "shine_core_control_plane",
  "ownerServiceId": "foundation.gateway",
  "ownerComponent": "shine-core",
  "sourceHandoffLedger": "foundation.foundation_promoted_release_owner_handoffs",
  "responseLedger": "foundation.foundation_promoted_release_owner_handoff_responses",
  "ownerInbox": "foundation.get_foundation_promoted_release_owner_inbox_v1",
  "responseFunction": "foundation.respond_foundation_promoted_release_owner_handoff_v1",
  "responseStatus": "foundation.get_foundation_promoted_release_owner_handoff_response_status_v1",
  "responseStates": ["accepted","rejected","clarification-requested"],
  "invariants": {
    "shineCoreCapabilityAlreadyExists": true,
    "shineCoreCapabilityIsNoLoginNoInheritNoBypassRls": true,
    "gatewayCannotAssumeOwnerCapability": true,
    "foundationRuntimeCannotAssumeOwnerCapability": true,
    "onlyShineCoreControlPlaneMayReadInbox": true,
    "onlyShineCoreControlPlaneMayRespond": true,
    "ownerHasNoDirectHandoffTableSelect": true,
    "ownerHasNoDirectResponseTableSelect": true,
    "ownerHasNoDirectResponseInsert": true,
    "responseSingleUse": true,
    "responseBindsHandoffSha256": true,
    "responseBindsResponsePlanFingerprint": true,
    "recoveredOrStaleHandoffMakesResponseStale": true,
    "acceptanceAcknowledgesWorkOwnershipOnly": true,
    "layer38ApprovalGranted": false,
    "releaseTruthMutationAuthorityGranted": false,
    "releaseRebindAuthorityGranted": false,
    "incidentHistoryMutationAuthorityGranted": false,
    "runtimeMutationAuthorityGranted": false,
    "incidentClosurePerformed": false,
    "promotionTrustChanged": false,
    "approvalGranted": false,
    "executionAuthorityGranted": false,
    "executesAction": false
  }
}
