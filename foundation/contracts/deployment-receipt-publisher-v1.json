{
  "deploymentReceiptPublisher": "shine-foundation/deployment-receipt-publisher-v1",
  "schemaVersion": "1.1.0",
  "purpose": "Automatically publish verified non-secret Foundation deployment receipts from an approved GitHub Actions workflow using GitHub OIDC, without storing a Supabase service-role or management token in GitHub.",
  "workflow": ".github/workflows/publish-foundation-deployment-receipt.yml",
  "trigger": {
    "workflowDispatch": true,
    "pushOnReceiptManifest": true,
    "receiptManifest": "foundation/deployments/current-foundation-gateway-provider-receipt.json"
  },
  "identity": {
    "mechanism": "GitHub Actions OIDC",
    "audience": "shine-foundation-deployment-receipt",
    "issuer": "https://token.actions.githubusercontent.com",
    "repository": "doug-dotcom/ShineUniverse-shine-core",
    "ref": "refs/heads/main",
    "workflowRef": "doug-dotcom/ShineUniverse-shine-core/.github/workflows/publish-foundation-deployment-receipt.yml@refs/heads/main",
    "repositorySecretsRequired": false
  },
  "ingest": {
    "edgeFunction": "foundation-deployment-receipt-ingest",
    "endpoint": "https://sjpxqeyewahraxvidvcc.supabase.co/functions/v1/foundation-deployment-receipt-ingest",
    "verifyJwt": false,
    "authentication": "GitHub OIDC RS256 verified against issuer JWKS",
    "source": "foundation/runtime/deployment-receipt-ingest/index.ts",
    "databaseWrite": "foundation.submit_service_deployment_receipt_v1"
  },
  "receipt": {
    "requiredEvidence": [
      "runtimeVersion",
      "artifactSha256",
      "runtimeState",
      "sourceCommit",
      "providerEvidenceRef",
      "providerObservedAt",
      "rollback"
    ],
    "exactSourceCommitRequired": true,
    "sourceCommitMustExistInRepository": true,
    "artifactSha256Required": true,
    "payloadContainsSecrets": false
  },
  "security": {
    "supabaseServiceRoleInGithub": false,
    "supabaseManagementPatInGithub": false,
    "providerCredentialInDatabase": false,
    "anonymousIngestRejected": true,
    "oidcRepositoryPinned": true,
    "oidcBranchPinned": true,
    "oidcWorkflowPinned": true,
    "oidcAudiencePinned": true
  },
  "resultRules": {
    "acceptedReceiptStatuses": [
      "reconciled",
      "replayed"
    ],
    "unsafeReconciliationStates": [
      "unknown",
      "drift"
    ],
    "awaitingProofAllowedForNewRuntime": true
  },
  "productionProof": {
    "workflowRun": 36389217864,
    "workflowConclusion": "success",
    "ingestFunctionVersion": 1,
    "ingestHttpStatus": 200,
    "receiptStatus": "replayed",
    "reconciliationState": "reconciled",
    "unauthenticatedHttpStatus": 401,
    "runtimeVersion": "85",
    "artifactSha256": "a596c895d31e272d2358d69e500eb708a43462de69df32e7e8a87d540907b83f",
    "sourceCommit": "b7c5331f93eff28a781f0794c89ccf50e90a4045"
  }
}
