{
  "contract": "shine-foundation/case-audit-verification-reconciliation-incident-response-v1",
  "version": "1.0.0",
  "layer": 85,
  "purpose": "Classify Layer-84 reconciliation-coverage incident causes and admit only bounded read-only diagnosis or a Layer-82 reconciliation for a pure reconciliation omission, while explicitly denying upstream reruns, receipt/proof fabrication or mutation, evidence repair, incident-history suppression and release-truth mutation.",
  "causeReader": "foundation.get_case_audit_verify_reconcile_incident_cause_v1",
  "evaluator": "foundation.evaluate_case_audit_verify_reconcile_incident_response_v1",
  "plan": "foundation.get_case_audit_verify_reconcile_incident_response_plan_v1",
  "sourceIncident": "foundation.get_case_audit_verify_reconcile_incident_summary_v1",
  "sourceCoverage": "foundation.get_case_audit_verify_reconcile_coverage_v1",
  "boundedReconciler": "foundation.run_case_audit_verify_exec_reconciliation_v1",
  "causeClasses": [
    "none",
    "reconciliation-receipt-integrity",
    "verification-proof-integrity",
    "executor-receipt-mismatch",
    "verification-proof-missing",
    "durable-evidence-drift",
    "verification-coverage-drift",
    "reconciliation-omission",
    "reconciliation-coverage-gap",
    "unknown"
  ],
  "allowedActions": {
    "inspect-reconciliation-coverage": "read-only",
    "inspect-overdue-reconciliations": "read-only-when-relevant",
    "inspect-reconciliation-receipt": "read-only-when-relevant",
    "inspect-executor-receipt": "read-only-when-relevant",
    "inspect-verification-chain": "read-only-when-relevant",
    "inspect-durable-evidence-chain": "read-only-when-relevant",
    "inspect-verification-coverage": "read-only-when-relevant",
    "run-independent-reconciliation": "layer-82-bounded-reconciler-when-reconciliation-omission"
  },
  "prohibitedActions": [
    "rerun-layer81",
    "rerun-verification",
    "manufacture-reconciliation-receipt",
    "rewrite-reconciliation-receipt",
    "delete-reconciliation-receipt",
    "repair-reconciliation-ledger",
    "manufacture-verification-proof",
    "rewrite-verification-proof",
    "delete-verification-proof",
    "repair-durable-evidence",
    "suppress-reconciliation-coverage-incident",
    "delete-reconciliation-coverage-incident-history",
    "mutate-release-truth"
  ],
  "readerRoles": [
    "foundation_runtime",
    "service_role"
  ],
  "invariants": {
    "causeUsesCurrentLayer84IncidentAndLayer83Coverage": true,
    "invalidReconciliationReceiptHasHighestPriority": true,
    "upstreamIntegrityFailuresDominateReconciliationOmission": true,
    "overdueMissingReceiptCanAdmitBoundedLayer82Reconciler": true,
    "existingNegativeReconciliationDoesNotAdmitReconciliationReplay": true,
    "responsePolicyNeverExecutesAction": true,
    "noAutomaticReconciliation": true,
    "noAutomaticVerification": true,
    "noAutomaticRepair": true,
    "noReconciliationReceiptRewrite": true,
    "noVerificationProofRewrite": true,
    "noHistoryRewrite": true,
    "noLayer81Rerun": true,
    "noVerificationRerun": true,
    "noAuthorityExpansion": true,
    "evidenceRepairProhibited": true,
    "releaseTruthMutationProhibited": true,
    "unknownActionsFailClosed": true,
    "gatewayReadInheritedViaFoundationRuntime": true,
    "gatewayReceivesNoDirectGrant": true,
    "ownerDenied": true,
    "defenceDenied": true,
    "browserRolesDenied": true
  }
}
