{
  "contract": "shine-foundation/case-audit-layer91-execution-reconciliation-v1",
  "version": "1.0.0",
  "layer": 92,
  "purpose": "Independently reconcile one successful Layer-91 bounded Layer-87 reconciliation execution against the durable Layer-87 receipt, recomputing receipt integrity and execution-claim fidelity without rerunning or rewriting any upstream control.",
  "evaluator": "foundation.evaluate_case_audit_layer91_execution_outcome_v1",
  "reconciler": "foundation.run_case_audit_layer91_execution_reconciliation_v1",
  "summary": "foundation.get_case_audit_layer91_execution_reconciliation_summary_v1",
  "ledger": "foundation.case_audit_reconcile_exec_reconcile_exec_reconciliations",
  "sourceExecutorLedger": "foundation.case_audit_reconcile_exec_reconcile_exec_events",
  "sourceLayer87Ledger": "foundation.case_audit_verify_reconcile_exec_reconciliations",
  "sourceLayer86Ledger": "foundation.case_audit_verify_reconcile_exec_events",
  "sourceLayer89IncidentLedger": "foundation.case_audit_reconcile_exec_coverage_incident_events",
  "sourcePolicyFingerprint": "foundation.case_audit_reconcile_exec_reconcile_exec_policy_fp_v1",
  "states": [
    "reconciled",
    "missing-layer87-receipt",
    "invalid-layer87-receipt",
    "execution-receipt-mismatch",
    "policy-drift",
    "incident-drift",
    "coverage-drift"
  ],
  "invariants": {
    "oneReceiptPerLayer91Execution": true,
    "onlySuccessfulLayer91ExecutionsCanReconcile": true,
    "layer91PolicyFingerprintRecomputed": true,
    "layer89IncidentBindingRevalidated": true,
    "layer87ProofHashRecomputed": true,
    "layer87ProofStructureRevalidated": true,
    "layer91ActionResultMustMatchLayer87Receipt": true,
    "beforeAndAfterLayer88CoverageRevalidated": true,
    "integrityFailureDominatesExecutionMismatch": true,
    "missingLayer87TruthIsRecordedNotInvented": true,
    "semanticReplayReturnsExistingReceipt": true,
    "reconciliationLedgerAppendOnly": true,
    "serviceRoleCanReconcileButCannotDirectInsert": true,
    "runtimeCanReadButCannotReconcile": true,
    "gatewayReadOnlyViaFoundationRuntimeInheritance": true,
    "ownerDenied": true,
    "defenceDenied": true,
    "browserRolesDenied": true,
    "noLayer87Rerun": true,
    "noLayer86Rerun": true,
    "noLayer82Rerun": true,
    "noLayer81Rerun": true,
    "noVerificationRerun": true,
    "noEvidenceMutation": true,
    "noLayer87ReceiptRewrite": true,
    "noLayer86ReceiptRewrite": true,
    "noLayer82ReceiptRewrite": true,
    "noReleaseTruthMutation": true,
    "noIncidentHistoryMutation": true,
    "noApprovalGranted": true,
    "noExecutionAuthorityGranted": true
  }
}
