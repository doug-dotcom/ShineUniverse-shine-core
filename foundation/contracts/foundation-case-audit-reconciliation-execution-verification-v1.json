{
  "contract": "shine-foundation/case-audit-reconciliation-execution-verification-v1",
  "version": "1.0.0",
  "layer": 87,
  "purpose": "Independently verify each successful Layer-86 reconciliation execution against its durable Layer-82 receipt, Layer-82 proof integrity, exact Layer-81 target, Layer-84 incident evidence and recomputed Layer-85 policy envelope without rerunning or rewriting any upstream control.",
  "evaluator": "foundation.evaluate_case_audit_reconcile_exec_verification_v1",
  "runner": "foundation.run_case_audit_reconcile_exec_verification_v1",
  "summary": "foundation.get_case_audit_reconcile_exec_verification_summary_v1",
  "ledger": "foundation.case_audit_verify_reconcile_exec_verifications",
  "sourceExecutorLedger": "foundation.case_audit_verify_reconcile_exec_events",
  "sourceTargetLedger": "foundation.case_audit_verify_exec_events",
  "sourceReconciliationLedger": "foundation.case_audit_verify_exec_reconciliations",
  "sourceIncidentLedger": "foundation.case_audit_verify_reconcile_incident_events",
  "policyFingerprint": "foundation.case_audit_verify_reconcile_exec_policy_fp_v1",
  "verificationStates": [
    "verified",
    "missing-reconciliation",
    "policy-mismatch",
    "receipt-mismatch",
    "invalid-reconciliation-proof"
  ],
  "invariants": {
    "onlySuccessfulLayer86ExecutionsRequireVerification": true,
    "layer82ReceiptReadIndependently": true,
    "layer82ProofHashRecomputed": true,
    "layer82ProofEnvelopeValidated": true,
    "layer86PolicyFingerprintRecomputed": true,
    "layer86TargetSnapshotBoundToLayer81": true,
    "layer86IncidentSnapshotBoundToLayer84": true,
    "layer86ActionResultMustMatchLayer82Receipt": true,
    "noLayer82Rerun": true,
    "noLayer81Rerun": true,
    "noVerificationRerun": true,
    "noEvidenceMutation": true,
    "noReconciliationReceiptRewrite": true,
    "noVerificationProofRewrite": true,
    "noReleaseTruthMutation": true,
    "noIncidentHistoryMutation": true,
    "semanticReplayReturnsExistingVerification": true,
    "verificationLedgerAppendOnly": true,
    "serviceRoleCannotDirectInsertVerificationLedger": true,
    "runnerServiceRoleOnly": true,
    "gatewaySummaryReadOnlyViaFoundationRuntimeInheritance": true,
    "gatewayReceivesNoDirectGrant": true,
    "ownerDenied": true,
    "defenceDenied": true,
    "browserRolesDenied": true
  }
}
