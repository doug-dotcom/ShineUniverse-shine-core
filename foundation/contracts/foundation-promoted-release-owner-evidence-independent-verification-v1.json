{
  "contract": "shine-foundation/promoted-release-owner-evidence-independent-verification-v1",
  "version": "1.0.0",
  "layer": 70,
  "purpose": "Use current integrity-verified Shine Core owner evidence only as a trigger for a fresh independent Foundation promotion-trust evaluation, recording an immutable verification proof without allowing owner claims to become canonical trust.",
  "executorRole": "service_role",
  "evaluator": "foundation.evaluate_foundation_promoted_release_independent_recovery_v1",
  "runner": "foundation.run_promoted_release_owner_evidence_verification_v1",
  "statusReader": "foundation.get_promoted_release_owner_evidence_verification_status_v1",
  "ledger": "foundation.foundation_promoted_release_owner_evidence_verifications",
  "verificationStates": [
    "recovered",
    "impaired",
    "indeterminate"
  ],
  "ownerClaimAlignment": [
    "agrees",
    "disagrees",
    "inconclusive"
  ],
  "independentDimensions": [
    "canonical-source-truth",
    "promotion-closure",
    "promoted-release-availability",
    "live-promotion-observation",
    "promotion-trust-incident-lifecycle"
  ],
  "invariants": {
    "currentIntegrityVerifiedOwnerEvidenceRequired": true,
    "freshOwnerEvidenceRequired": true,
    "ownerCannotRunIndependentVerification": true,
    "foundationRuntimeCannotRunIndependentVerification": true,
    "gatewayCannotRunIndependentVerification": true,
    "defenceCannotRunIndependentVerification": true,
    "serviceRoleUsesBoundedRunnerNotDirectInsert": true,
    "ownerOutcomeIsNotEvaluatorInput": true,
    "ownerFactsAreNotEvaluatorInputs": true,
    "ownerEvidenceUsedAsTriggerOnly": true,
    "ownerOutcomeAcceptedAsPromotionTrust": false,
    "recoveredRequiresAllIndependentDimensions": true,
    "missingOrStaleIndependentEvidenceIsIndeterminate": true,
    "explicitNegativeIndependentEvidenceIsImpaired": true,
    "oneVerificationPerEvidenceReturn": true,
    "replayPreservesFirstVerification": true,
    "historicalVerificationRemainsImmutableAfterLaterRecovery": true,
    "incidentClosurePerformed": false,
    "promotionTrustChangedByVerification": false,
    "releaseTruthMutationPerformed": false,
    "approvalGranted": false,
    "executionAuthorityGranted": false,
    "executesAction": false
  }
}
