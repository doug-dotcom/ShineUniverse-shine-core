{
  "contract": "shine-foundation/case-audit-bounded-reconciliation-executor-v1",
  "version": "1.0.0",
  "layer": 86,
  "purpose": "Execute only Layer-85-admitted independent reconciliation for one specific overdue successful Layer-81 event, through the existing Layer-82 reconciler, while sealing direct service-role access to Layer 82 and preserving append-only execution evidence.",
  "executor": "foundation.execute_case_audit_overdue_reconciliation_v1",
  "summary": "foundation.get_case_audit_verify_reconcile_exec_summary_v1",
  "ledger": "foundation.case_audit_verify_reconcile_exec_events",
  "policyFingerprint": "foundation.case_audit_verify_reconcile_exec_policy_fp_v1",
  "governedPolicy": "foundation.evaluate_case_audit_verify_reconcile_incident_response_v1",
  "boundedTarget": "foundation.run_case_audit_verify_exec_reconciliation_v1",
  "sourceExecutorLedger": "foundation.case_audit_verify_exec_events",
  "sourceReconciliationLedger": "foundation.case_audit_verify_exec_reconciliations",
  "sourceCoverage": "foundation.get_case_audit_verify_reconcile_coverage_v1",
  "sourceIncident": "foundation.get_case_audit_verify_reconcile_incident_summary_v1",
  "executableAction": "run-independent-reconciliation",
  "requiredControl": "layer-82-bounded-reconciler",
  "invariants": {
    "oneSpecificLayer81EventPerCall": true,
    "targetMustExist": true,
    "targetMustBeSuccessfulLayer81Execution": true,
    "targetMustBePastReconciliationGrace": true,
    "targetMustHaveNoExistingLayer82Receipt": true,
    "layer84IncidentMustBeWatchingOrCritical": true,
    "layer85MustAdmitRunIndependentReconciliation": true,
    "layer85CauseMustBeReconciliationOmission": true,
    "onlyLayer82ReconcilerCanBeInvoked": true,
    "directServiceRoleLayer82BypassRevoked": true,
    "serviceRoleUsesLayer86Executor": true,
    "semanticReplayReturnsExistingExecution": true,
    "oneSuccessfulLayer86ExecutionPerTarget": true,
    "executorLedgerAppendOnly": true,
    "serviceRoleCannotDirectInsertExecutorLedger": true,
    "noLayer81Rerun": true,
    "noVerificationRerun": true,
    "noDurableEvidenceMutation": true,
    "noReconciliationReceiptRewrite": true,
    "noVerificationProofRewrite": true,
    "noReleaseTruthMutation": true,
    "noIncidentHistoryMutation": true,
    "noArbitrarySqlExecution": true,
    "gatewaySummaryReadOnlyViaFoundationRuntimeInheritance": true,
    "ownerDenied": true,
    "defenceDenied": true,
    "browserRolesDenied": true
  }
}
