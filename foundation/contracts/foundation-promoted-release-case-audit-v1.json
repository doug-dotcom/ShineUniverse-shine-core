{
  "contract": "shine-foundation/promoted-release-case-audit-v1",
  "version": "1.0.0",
  "layer": 72,
  "purpose": "Provide a read-only internal Foundation audit of the complete promotion-trust work/proof chain, detecting overdue missing handoffs, invalid hashes, broken cross-stage bindings and legitimate pending/terminal stages.",
  "reader": "foundation.get_foundation_promoted_release_case_audit_v1",
  "readerRoles": [
    "foundation_runtime",
    "service_role"
  ],
  "stages": [
    "awaiting-owner-response",
    "owner-rejected",
    "clarification-requested",
    "awaiting-owner-evidence",
    "awaiting-independent-verification",
    "verified",
    "invalid"
  ],
  "overallStates": [
    "idle",
    "active-work",
    "historical",
    "gap",
    "invalid"
  ],
  "activeHandoffStates": [
    "not-required",
    "grace",
    "present",
    "missing"
  ],
  "invariants": {
    "readOnly": true,
    "activeWarningOrCriticalIncidentRequiresHandoffAfterGrace": true,
    "currentIncidentHandoffGraceSecondsDefault": 180,
    "handoffHashVerified": true,
    "responseHashVerified": true,
    "evidenceHashVerified": true,
    "verificationHashVerified": true,
    "responseMustBindHandoff": true,
    "evidenceMustBindResponseAndHandoff": true,
    "verificationMustBindEvidenceResponseHandoffAndIncident": true,
    "evidenceWithoutResponseInvalid": true,
    "verificationWithoutEvidenceInvalid": true,
    "rejectionIsValidTerminalStage": true,
    "verificationIsValidTerminalStage": true,
    "historicalCasesRemainAuditable": true,
    "ownerCannotReadInternalAudit": true,
    "browserRolesDenied": true,
    "mutatesAuthoritativeTruth": false,
    "mutatesIncidentHistory": false,
    "grantsApproval": false,
    "grantsExecutionAuthority": false
  }
}
