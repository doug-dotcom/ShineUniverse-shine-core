{
  "contract": "shine-foundation/promoted-release-incident-lifecycle-v1",
  "version": "1.0.0",
  "layer": 65,
  "purpose": "Escalate persistent loss of consumer-visible Foundation promotion trust into append-only incidents without granting automatic repair authority.",
  "source": "foundation.get_foundation_promoted_release_observation_summary_v1",
  "ledger": "foundation.foundation_promoted_release_incident_events",
  "currentStateView": "foundation.current_foundation_promoted_release_incident_state",
  "activeIncidentsView": "foundation.current_foundation_promoted_release_incidents",
  "watchesView": "foundation.current_foundation_promoted_release_watches",
  "sentinel": "foundation.run_foundation_promoted_release_incident_sentinel_v1",
  "summary": "foundation.get_foundation_promoted_release_incident_summary_v1",
  "persistenceThresholdSeconds": 300,
  "sourceStates": [
    "normal",
    "hold",
    "drift",
    "unknown"
  ],
  "lifecycle": [
    "detected",
    "opened",
    "changed",
    "recovered"
  ],
  "severityMapping": {
    "hold": "critical",
    "drift": "warning",
    "unknown": "warning",
    "normal": "non-incident"
  },
  "rules": {
    "firstBadSampleCreatesWatch": true,
    "persistenceRequiredBeforeOpen": true,
    "materialEvidenceChangeAppendsChangedEvent": true,
    "normalRecoversWatchOrIncident": true,
    "unchangedOpenEvidenceDoesNotAppendNoise": true,
    "directIncidentInsertDeniedToServiceRole": true,
    "transitionHelperOwnerPrivate": true,
    "automaticRepair": false,
    "runtimeReadinessClaimed": false,
    "mutatesAuthoritativeTruth": false
  },
  "hostedSentinel": {
    "engine": "pg_cron",
    "jobName": "shine-foundation-promoted-release-incident-5m",
    "cadence": "1,6,11,16,21,26,31,36,41,46,51,56 * * * *",
    "observationMaxAgeSeconds": 600
  }
}
