    "foundation.case_audit_safe_response_verifications"
  ],
  "states": [
    "idle",
    "normal",
    "pending",
    "gap",
    "invalid"
  ],
  "itemStates": [
    "verified",
    "pending",
    "unverified",
    "missing",
    "mismatch",
    "invalid"
  ],
  "invariants": {
    "onlyExecutedLayer76ReceiptsRequireVerification": true,
    "deniedAndFailedExecutionsExcluded": true,
    "verificationGracePeriodExplicit": true,
    "overdueUnverifiedReceiptsAreGaps": true,
    "missingDurableEvidenceIsGap": true,
