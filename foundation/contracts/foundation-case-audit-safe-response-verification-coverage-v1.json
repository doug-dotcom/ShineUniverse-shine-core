    "proofColumnsMustMatchProofDocument": true,
    "proofActionResultMustMatchExecutionReceipt": true,
    "invalidProofDominatesOverallState": true,
    "readOnlyAudit": true,
    "targetReexecuted": false,
    "historyRewritePerformed": false,
    "releaseTruthMutationPerformed": false,
    "incidentHistoryMutationPerformed": false,
    "mutationPerformed": false
  }
