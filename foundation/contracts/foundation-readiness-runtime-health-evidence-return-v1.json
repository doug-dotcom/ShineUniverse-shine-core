{
  "contract": "shine-foundation/foundation-readiness-runtime-health-evidence-return-v1",
  "version": "1.0.0",
  "layer": 58,
  "purpose": "Allow the accepted Shine-core runtime-health investigation owner to return one immutable evidence packet without making owner claims canonical health or readiness truth.",
  "ownerPrincipal": "shine_core_control_plane",
  "returnFunction": "foundation.return_readiness_runtime_health_investigation_evidence_v1",
  "statusFunction": "foundation.get_readiness_runtime_health_investigation_evidence_return_status_v1",
  "ledger": "foundation.readiness_runtime_health_investigation_evidence_returns",
  "ownerReportedOutcomes": ["resolved","improved","unchanged","worsened","inconclusive"],
  "ownerReportedHealthStates": ["healthy","degraded","unhealthy","unknown"],
  "invariants": {
    "acceptedCurrentInvestigationRequired": true,
    "oneImmutableEvidenceReturnPerProposal": true,
    "replayPreservesFirstEvidencePacket": true,
    "ownerDirectLedgerInsert": false,
    "ownerDirectLedgerSelect": false,
    "gatewayCannotReturnOwnerEvidence": true,
    "foundationRuntimeCannotReturnOwnerEvidence": true,
    "serviceRoleCannotAuthorOwnerEvidence": true,
    "defenceCannotAuthorShineCoreEvidence": true,
    "ownerEvidenceIsCanonicalHealth": false,
    "ownerHealthClaimOnly": true,
    "requiresIndependentRetest": true,
    "readinessChangedByOwnerEvidence": false,
    "healthChangedByOwnerEvidence": false,
    "incidentClosurePerformed": false,
    "runtimeMutationAuthorityGranted": false,
    "healthPolicyMutationAuthorityGranted": false,
    "releaseRebindAuthorityGranted": false,
    "safeModeBypassAuthorityGranted": false,
    "approvalGranted": false,
    "executionAuthorityGranted": false,
    "executesRemediation": false
  }
}
