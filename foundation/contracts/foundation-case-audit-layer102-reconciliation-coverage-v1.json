    "readerPerformsNoLayer102Reconciliation": true,
    "noLayer101Rerun": true,
    "noLayer97Rerun": true,
    "noLayer96Rerun": true,
    "noLayer92Rerun": true,
    "noLayer91Rerun": true,
    "noLayer87Rerun": true,
    "noLayer86Rerun": true,
    "noLayer82Rerun": true,
    "noLayer81Rerun": true,
    "noVerificationRerun": true,
    "noEvidenceMutation": true,
    "noLayer102ReceiptRewrite": true,
    "noLayer97ReceiptRewrite": true,
    "noLayer96ReceiptRewrite": true,
    "noLayer92ReceiptRewrite": true,
    "noReleaseTruthMutation": true,
    "noIncidentHistoryMutation": true,
    "gatewayReadInheritedViaFoundationRuntime": true,
