    "overdue",
    "invalid-reconciliation",
    "reconciled",
    "missing-layer97-receipt",
    "invalid-layer97-receipt",
    "execution-receipt-mismatch",
    "policy-drift",
    "incident-drift",
    "coverage-drift"
  ],
  "metrics": {
    "coverage": "layer102ReconciliationCoveragePercent",
    "health": "healthyLayer102ReconciliationPercent"
