{
  "contract": "shine-foundation/case-audit-verification-exec-reconciliation-v1",
  "version": "1.0.0",
  "layer": 82,
  "purpose": "Independently reconcile each successful Layer-81 execution receipt against the durable Layer-77 proof, current Layer-76 evidence evaluation, current Layer-78 coverage, and the Layer-81 policy envelope without rerunning verification or mutating authoritative truth.",
  "evaluator": "foundation.evaluate_case_audit_verify_exec_outcome_v1",
  "runner": "foundation.run_case_audit_verify_exec_reconciliation_v1",
  "summary": "foundation.get_case_audit_verify_reconcile_summary_v1",
  "ledger": "foundation.case_audit_verify_exec_reconciliations",
  "sourceExecutorLedger": "foundation.case_audit_verify_exec_events",
  "sourceVerificationLedger": "foundation.case_audit_safe_response_verifications",
  "sourceCoverage": "foundation.get_case_audit_safe_response_verification_coverage_v1",
  "sourceEvidenceEvaluator": "foundation.evaluate_case_audit_safe_response_execution_v1",
  "reconciliationStates": [
    "reconciled",
    "missing-proof",
    "receipt-mismatch",
    "invalid-proof",
    "evidence-drift",
    "coverage-drift"
  ],
  "invariants": {
    "onlySuccessfulLayer81ExecutionsAreReconciled": true,
    "layer81PolicyFingerprintRecomputed": true,
    "layer81TargetEnvelopeMustMatchLayer76": true,
    "layer81AdmissionMustShowVerificationAbsent": true,
    "layer81DecisionMustRemainBounded": true,
    "layer77ProofHashRecomputed": true,
    "layer77ProofEnvelopeReboundToLayer76": true,
    "layer81ActionResultMustMatchLayer77Row": true,
    "originalDurableEvidenceReevaluated": true,
    "currentEvaluationMustMatchLayer77Outcome": true,
    "currentLayer78CoverageRead": true,
    "visibleTargetCoverageMustMatchProof": true,
    "missingProofPreserved": true,
    "invalidProofPreserved": true,
    "receiptMismatchPreserved": true,
    "evidenceDriftPreserved": true,
    "coverageDriftPreserved": true,
    "oneImmutableReconciliationPerLayer81Execution": true,
    "replayReturnsFirstReconciliation": true,
    "noLayer77Rerun": true,
    "noLayer81Rerun": true,
    "noEvidenceMutation": true,
    "noVerificationProofRewrite": true,
    "noReleaseTruthMutation": true,
    "noIncidentHistoryMutation": true,
    "serviceRoleUsesBoundedRunnerNotDirectInsert": true,
    "foundationRuntimeReadOnly": true,
    "gatewayReadInheritedViaFoundationRuntime": true,
    "gatewayReceivesNoDirectGrant": true,
    "ownerDenied": true,
    "defenceDenied": true,
    "browserRolesDenied": true
  }
}
