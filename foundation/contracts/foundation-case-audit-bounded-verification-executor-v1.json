{
  "contract": "shine-foundation/case-audit-bounded-verification-executor-v1",
  "version": "1.0.0",
  "layer": 81,
  "purpose": "Provide the sole service-role execution doorway for Layer-80-admitted overdue independent verification, binding one specific successful Layer-76 receipt to an active Layer-79 verification-coverage incident and invoking only the existing Layer-77 verifier.",
  "executor": "foundation.execute_case_audit_overdue_verification_v1",
  "ledger": "foundation.case_audit_verify_exec_events",
  "summary": "foundation.get_case_audit_verify_exec_summary_v1",
  "policyFingerprint": "foundation.case_audit_verify_exec_policy_fp_v1",
  "underlyingVerifier": "foundation.run_case_audit_safe_response_verification_v1",
  "executableAction": "run-independent-verification",
  "requiredControl": "layer-77-bounded-verifier",
  "executorRole": "service_role",
  "readerRoles": [
    "foundation_runtime",
    "service_role"
  ],
  "invariants": {
    "oneExplicitTargetPerCall": true,
    "targetMustBeSuccessfulLayer76Receipt": true,
    "targetMustBePastVerificationGrace": true,
    "targetMustHaveNoLayer77ProofAtAdmission": true,
    "layer79IncidentMustBeWatchingOrCritical": true,
    "layer80DecisionMustAdmit": true,
    "layer80CauseMustBeVerificationOmission": true,
    "layer80RequiredControlMustMatch": true,
    "sameTargetCallsSerializedWithAdvisoryLock": true,
    "atMostOneExecutedLayer81EventPerTarget": true,
    "replayReturnsFirstExecutedEvent": true,
    "directServiceRoleLayer77BypassRevoked": true,
    "layer81IsOnlyServiceRoleVerificationWriterEntryPoint": true,
    "layer77VerifierRemainsImmutableAndReplaySafe": true,
    "noTargetScanningOrAutomaticSelection": true,
    "safeResponseRerunPerformed": false,
    "evidenceMutationPerformed": false,
    "verificationProofRewritePerformed": false,
    "releaseTruthMutationPerformed": false,
    "incidentHistoryMutationPerformed": false,
    "executorLedgerAppendOnly": true,
    "serviceRoleCannotInsertExecutorLedgerDirectly": true,
    "gatewayReadInheritedViaFoundationRuntime": true,
    "gatewayReceivesNoDirectSummaryGrant": true,
    "ownerDenied": true,
    "defenceDenied": true,
    "browserRolesDenied": true
  }
}
