{
  "contract": "shine-foundation/case-audit-bounded-verification-executor-v1",
  "version": "1.0.0",
  "layer": 81,
  "purpose": "Execute only Layer-80-admitted independent verification for one specific overdue successful Layer-76 receipt, through the existing Layer-77 verifier, while sealing direct service-role access to Layer 77 and preserving append-only execution evidence.",
  "executor": "foundation.execute_case_audit_overdue_verification_v1",
  "summary": "foundation.get_case_audit_verify_exec_summary_v1",
  "ledger": "foundation.case_audit_verify_exec_events",
  "policyFingerprint": "foundation.case_audit_verify_exec_policy_fp_v1",
  "governedPolicy": "foundation.evaluate_case_audit_verify_incident_response_v1",
  "boundedTarget": "foundation.run_case_audit_safe_response_verification_v1",
  "sourceExecutionLedger": "foundation.case_audit_safe_response_exec_events",
  "sourceVerificationLedger": "foundation.case_audit_safe_response_verifications",
  "sourceCoverage": "foundation.get_case_audit_safe_response_verification_coverage_v1",
  "sourceIncident": "foundation.get_case_audit_verify_incident_summary_v1",
  "executableAction": "run-independent-verification",
  "requiredControl": "layer-77-bounded-verifier",
  "invariants": {
    "oneSpecificExecutionReceiptPerCall": true,
    "targetMustExist": true,
    "targetMustBeSuccessfulLayer76Execution": true,
    "targetMustBePastVerificationGrace": true,
    "targetMustHaveNoExistingLayer77Proof": true,
    "layer79IncidentMustBeWatchingOrCritical": true,
    "layer80MustAdmitRunIndependentVerification": true,
    "layer80CauseMustBeVerificationOmission": true,
    "onlyLayer77VerifierCanBeInvoked": true,
    "directServiceRoleLayer77BypassRevoked": true,
    "serviceRoleUsesLayer81Executor": true,
    "semanticReplayReturnsExistingExecution": true,
    "oneSuccessfulLayer81ExecutionPerTarget": true,
    "executorLedgerAppendOnly": true,
    "serviceRoleCannotDirectInsertExecutorLedger": true,
    "noSafeResponseRerun": true,
    "noDurableEvidenceMutation": true,
    "noVerificationProofRewrite": true,
    "noReleaseTruthMutation": true,
    "noIncidentHistoryMutation": true,
    "noArbitrarySqlExecution": true,
    "gatewaySummaryReadOnlyViaFoundationRuntimeInheritance": true,
    "ownerDenied": true,
    "defenceDenied": true,
    "browserRolesDenied": true
  }
}
