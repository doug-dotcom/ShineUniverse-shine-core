{
  "openapi": "3.1.0",
  "info": {
    "title": "Shine Foundation Gateway",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "foundationHealth",
        "responses": {
          "200": {
            "description": "Gateway process is reachable."
          }
        }
      }
    },
    "/v1/access/evaluate": {
      "post": {
        "operationId": "evaluateFoundationAccess",
        "description": "Evaluate one scoped Foundation access request. Authentication is supplied outside the JSON envelope.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/gateway-request-v1.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Access allowed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/gateway-response-v1.schema.json"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request."
          },
          "401": {
            "description": "Authentication failed."
          },
          "403": {
            "description": "Access denied."
          },
          "503": {
            "description": "Foundation unavailable or audit could not be persisted."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque-or-jwt"
      }
    }
  }
}
