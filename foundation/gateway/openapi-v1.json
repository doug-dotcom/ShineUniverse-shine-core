{
  "openapi": "3.1.0",
  "info": {
    "title": "Shine Foundation Gateway",
    "version": "1.2.0"
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "foundationHealth",
        "responses": {
          "200": {
            "description": "Gateway process is reachable."
          }
        }
      }
    },
    "/v1/defence/status/{appId}": {
      "get": {
        "operationId": "getShineDefenceReleaseStatus",
        "description": "Public read-only Shine Defence status for one exact application commit/profile pair. No user or Vault data is exposed.",
        "parameters": [
          {
            "name": "appId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            }
          },
          {
            "name": "releaseSha",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            }
          },
          {
            "name": "profileBlobSha",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current Defence state for the supplied release identity."
          },
          "400": {
            "description": "Malformed app or SHA identity."
          },
          "405": {
            "description": "Only GET is supported."
          },
          "503": {
            "description": "Defence status service unavailable."
          }
        }
      }
    },
    "/v1/access/evaluate": {
      "post": {
        "operationId": "evaluateFoundationAccess",
        "description": "Evaluate one scoped Foundation access request. User and calling-app authentication are supplied outside the JSON envelope.",
        "security": [
          {
            "bearerAuth": [],
            "appToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/gateway-request-v1.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Access allowed."
          },
          "400": {
            "description": "Invalid request."
          },
          "401": {
            "description": "Transport authentication failed."
          },
          "403": {
            "description": "Access denied."
          },
          "413": {
            "description": "Request body exceeds the Gateway limit."
          },
          "503": {
            "description": "Foundation unavailable or audit could not be persisted."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Supabase user JWT"
      },
      "appToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Shine-App-Token",
        "description": "Server-side Shine app credential. Never embed in browser/mobile clients."
      }
    }
  }
}
