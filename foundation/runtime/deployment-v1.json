{
  "deployment": "shine-foundation/runtime-deployment-v1",
  "version": "1.0.0",
  "target": "supabase-edge-functions",
  "functionName": "foundation-gateway",
  "verifyJwt": true,
  "entrypoint": "foundation/runtime/edge-function/index.ts",
  "database": {
    "connectionEnv": "FOUNDATION_DATABASE_URL",
    "requiredRole": "foundation_gateway",
    "recommendedMode": "shared-pooler-transaction",
    "preparedStatements": false,
    "maxConnectionsPerIsolate": 1
  },
  "auth": {
    "projectEnv": "SUPABASE_URL",
    "keyPreference": ["SUPABASE_PUBLISHABLE_KEY", "SUPABASE_ANON_KEY"],
    "userTokenHeader": "Authorization",
    "appCredentialHeader": "X-Shine-App-Token",
    "appCredentialStorage": "SHA-256 only"
  },
  "pinnedDependencies": {
    "@supabase/supabase-js": "2.117.1",
    "postgres": "3.4.9"
  },
  "requiredPreDeployment": [
    "Apply foundation/postgres/persistence-v1.sql",
    "Apply foundation/postgres/runtime-v1.sql",
    "Set a strong password for the foundation_gateway database login",
    "Set FOUNDATION_DATABASE_URL to the transaction-pooler URL for foundation_gateway",
    "Provision verified foundation.identity_bindings rows",
    "Provision app credential SHA-256 hashes in foundation.app_credentials",
    "Keep Edge Function platform JWT verification enabled"
  ]
}
